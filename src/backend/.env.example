# Forge backend — every variable app/config.py reads.
#
# You do NOT need this file. Each variable below has the default shown, and the test
# suite, the seed script and the demo scripts all run with none of them set. Copy it only
# when you are running the backend **from source** and want to change something:
#
#     cp .env.example .env
#
# pydantic-settings reads `.env` from the working directory (src/backend). It is
# gitignored; `.env.example` is the committed one, and it is the only one that should
# ever contain a value. For the container stack, configuration lives in
# deploy/.env.example instead — compose passes these same names as real environment
# variables, which take precedence over anything in a `.env`.
#
# NO API KEY IS REQUIRED. The shipped agents' DNA names the deterministic in-process
# provider (ADR-005) and knowledge retrieval uses a hashing embedder, so everything here
# runs offline.

# The one value a deployment must really supply. Default:
# postgresql+psycopg://forge:forge@localhost:5432/forge — which is the compose `db`
# service as published on the host, so from-source runs need no override.
# A bare `postgresql://` scheme is rewritten to `postgresql+psycopg://`, because psycopg2
# is not installed and a platform-provided URL should not fail at connection time.
DATABASE_URL=postgresql+psycopg://forge:forge@localhost:5432/forge

# Anthropic credential for the one adapter that makes real model calls (ADR-005) — the
# single place in the platform a provider credential exists. Never in a DNA document, a
# tool, or the frontend. Default: unset. OPTIONAL: needed only if you point an agent's
# `model.provider` at "anthropic".
ANTHROPIC_API_KEY=

# Embedding provider behind semantic retrieval (app/knowledge/embeddings.py).
# Default: hashing — deterministic, offline, free. Optional. An unknown name refuses to
# start retrieval rather than falling back.
EMBEDDING_PROVIDER=hashing

# Origins the API accepts browser calls from, comma-separated (not JSON). Default:
# http://localhost:5173,http://127.0.0.1:5173 — the documented dev ports and nothing
# else. Optional. A wildcard would be one fewer line and a worse answer.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Circuit breaker (FR-G4, app/observability/containment.py). All optional; defaults shown.
# Trailing window an agent's runs are judged over, in seconds. Default: 3600.
BREAKER_WINDOW_SECONDS=3600
# Finished runs the window must hold before the failure rate is judged — two bad runs out
# of two is not yet a pattern. Default: 5.
BREAKER_MIN_RUNS=5
# Failure rate that suspends the published version, 0.0–1.0. Default: 0.5.
BREAKER_MAX_FAILURE_RATE=0.5
# Spend in the window that suspends it, USD. No minimum-run floor, because one absurdly
# expensive run is already the incident. Default: 2.50.
BREAKER_MAX_COST_USD=2.50

# Cosmetic, and listed only so this file is exhaustive.
# Service name reported by GET /api/v1/health. Default: Forge Platform API. Optional.
# APP_NAME=Forge Platform API
# Prefix every route is mounted under. Default: /api/v1. Optional, and changing it
# invalidates every URL in the docs and the SPA's hard-coded prefix.
# API_PREFIX=/api/v1
