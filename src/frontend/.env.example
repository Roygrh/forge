# Where the Forge API lives, as the *browser* sees it.
#
# This value is baked into the bundle at build time (Vite inlines VITE_* at build),
# so it names an address reachable from the user's machine — never a Docker service
# name. In the compose stack the API is published on the host at :8000, so the
# default below is correct there too.
VITE_API_BASE_URL=http://localhost:8000

# The demonstration role sent as X-Forge-Role on every request (NFR-5).
# configurator | approver | viewer. This is segregation of duties, not authentication.
VITE_FORGE_ROLE=configurator
