# Forge SPA — the two variables Vite reads at build/dev time.
#
# These matter when you run the SPA **from source** (`npm run dev`, `npm run build`).
# Vite inlines `VITE_*` into the bundle, so they are fixed at build time.
#
# The container does NOT use these. Its image is built with no VITE_* set on purpose, and
# nginx serves the equivalent values from the environment at container start as
# /config.js (see nginx/default.conf.template) — that is what keeps one image usable in
# every environment (ADR-009). Those are named FORGE_API_BASE_URL and FORGE_ROLE; see
# deploy/.env.example.
#
# Both are optional: src/api/client.ts falls back to the defaults noted below.
#
#     cp .env.example .env
#
# `.env` is gitignored; this file is the committed one.

# Where the Forge API lives, as the *browser* sees it. Default: http://localhost:8000,
# which is where the compose stack publishes it on the host. Optional.
# Never a Docker service name like http://api:8000 — that resolves to nothing in a
# browser running on the user's machine.
VITE_API_BASE_URL=http://localhost:8000

# The demonstration role sent as X-Forge-Role on every request (NFR-5).
# configurator | approver | viewer. Default: configurator. Optional.
# This is segregation of duties made visible, not authentication: it is switchable from
# the page header, and the server decides what a role may actually do. An unrecognised
# value falls back to `configurator` rather than being forwarded.
VITE_FORGE_ROLE=configurator
