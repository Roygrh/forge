# Forge reference deployment — every value the compose stack reads.
#
# You do NOT need this file to run Forge. Every variable below has the default shown,
# baked into deploy/docker-compose.yml, and `docker compose up` works with none of them
# set. Copy it only when you want to change something:
#
#     cp .env.example .env
#
# Compose reads `.env` from this directory automatically. It is gitignored; `.env.example`
# is the committed one, and it is the only one that should ever contain a value.
#
# NOTHING HERE IS REQUIRED FOR A WORKING STACK, INCLUDING THE API KEY. The shipped agents'
# DNA names the deterministic in-process provider (ADR-005) and the knowledge layer uses
# a hashing embedder, so the whole demonstration runs offline with no credential at all.


# ── PostgreSQL (service `db`) ────────────────────────────────────────────────────────
# Demo-grade credentials, committed deliberately (ADR-009 flags real secrets management
# as the first hardening item). They are used by `db`, and composed into DATABASE_URL for
# the backend, so changing one changes both.

# Database role the stack connects as. Default: forge. Optional.
POSTGRES_USER=forge
# Password for that role. Default: forge. Optional.
POSTGRES_PASSWORD=forge
# Database name. Default: forge. Optional.
POSTGRES_DB=forge


# ── Published host ports ─────────────────────────────────────────────────────────────
# Change these if something else on your machine already owns the port. The container
# ports never change; only what they are published as.

# PostgreSQL on the host — pytest and the seed script use it. Default: 5432. Optional.
FORGE_DB_PORT=5432
# The API on the host. Default: 8000. Optional.
FORGE_API_PORT=8000
# The SPA on the host. Default: 5173. Optional.
# Changing this means changing CORS_ORIGINS and FORGE_API_BASE_URL to match.
FORGE_WEB_PORT=5173


# ── Backend (services `api` and `migrate`) ───────────────────────────────────────────

# Where the API and the migrator find PostgreSQL. Composed from POSTGRES_* above, so it
# is NOT listed as an override here — set POSTGRES_USER/PASSWORD/DB instead, or edit
# docker-compose.yml to point at an external database.
# Required by the backend, always supplied by compose. Outside compose it defaults to
# postgresql+psycopg://forge:forge@localhost:5432/forge (src/backend/app/config.py).
# DATABASE_URL=postgresql+psycopg://forge:forge@db:5432/forge

# Anthropic credential for the one adapter that makes real model calls (ADR-005).
# Default: unset. OPTIONAL, and unnecessary for the demonstration — leave it empty unless
# you have pointed an agent's DNA `model.provider` at "anthropic".
ANTHROPIC_API_KEY=

# Embedding provider behind knowledge retrieval. Default: hashing (deterministic,
# offline, free). Optional. An unknown name refuses to start retrieval rather than
# silently falling back.
EMBEDDING_PROVIDER=hashing

# Origins the API accepts browser calls from, comma-separated. Default:
# http://localhost:5173,http://127.0.0.1:5173. Optional — but it must contain the origin
# the SPA is actually served from, so change it alongside FORGE_WEB_PORT. A wildcard is
# deliberately not the default.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Circuit breaker (FR-G4): the trailing window each agent's runs are judged over, and the
# two ceilings that suspend a published version. All optional; defaults shown.
# Seconds in the trailing window. Default: 3600.
BREAKER_WINDOW_SECONDS=3600
# Finished runs needed before the failure rate is judged at all. Default: 5.
BREAKER_MIN_RUNS=5
# Failure rate that trips the breaker, 0.0–1.0. Default: 0.5.
BREAKER_MAX_FAILURE_RATE=0.5
# Spend in the window that trips the breaker, USD. No minimum-run floor: one absurdly
# expensive run is already the incident. Default: 2.50.
BREAKER_MAX_COST_USD=2.50

# Two more the backend reads that compose does not set, listed for completeness — both
# optional, and there is no good reason to change either.
# Service name reported by GET /api/v1/health. Default: Forge Platform API.
# APP_NAME=Forge Platform API
# Prefix every route is mounted under. Default: /api/v1. Changing it changes every URL
# in the documentation and the SPA's hard-coded prefix, so: don't.
# API_PREFIX=/api/v1


# ── Frontend (service `web`) ─────────────────────────────────────────────────────────
# Read by nginx at container start and served to the browser as /config.js, so the image
# stays environment-independent (ADR-009). These are NOT the VITE_* variables — those are
# build-time and belong to `npm run dev` from source; see src/frontend/.env.example.

# The API's address AS THE BROWSER SEES IT. Default: http://localhost:8000. Optional.
# Never a Docker service name like http://api:8000 — that resolves to nothing in a
# browser on the host.
FORGE_API_BASE_URL=http://localhost:8000

# The demonstration role the SPA starts as, sent as X-Forge-Role (NFR-5).
# configurator | approver | viewer. Default: configurator. Optional. This is segregation
# of duties made visible, not authentication — it is switchable from the page header, and
# the server decides what a role may do.
FORGE_ROLE=configurator
